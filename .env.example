# Copy to .env and fill in real values. .env is gitignored - never commit it.
#
# One *_IMAP_PASSWORD entry per account's password_env in config.yaml.
# Many providers (Gmail, iCloud, etc.) require an app-specific password for
# IMAP rather than your main account password - generate one from that
# provider's account security settings.

EXAMPLE_ACCOUNT_IMAP_PASSWORD=
ANOTHER_ACCOUNT_IMAP_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides:
# LOG_LEVEL=info
# DRY_RUN=false
